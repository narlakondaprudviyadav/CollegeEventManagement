<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F7F5FC">


    <!-- ================================================= -->
    <!-- TOP HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:background="#6B4DB5"

        android:paddingStart="8dp"
        android:paddingEnd="12dp">


        <ImageButton
            android:id="@+id/backButton"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="@android:color/transparent"

            android:src="@drawable/ic_arrow_back"

            app:tint="@android:color/white"

            android:contentDescription="Back"

            android:clickable="true"
            android:focusable="true"

            android:padding="10dp" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical"

            android:paddingStart="6dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="My Profile"

                android:textColor="@android:color/white"

                android:textSize="22sp"

                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Manage your account"

                android:textColor="#E8E0FF"

                android:textSize="12sp"

                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- PROFILE CONTENT -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"

        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:gravity="center_horizontal"

            android:padding="24dp">


            <!-- ================================================= -->
            <!-- PROFILE PHOTO -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/profileImageView"

                android:layout_width="120dp"
                android:layout_height="120dp"

                android:layout_gravity="center_horizontal"

                android:src="@drawable/ic_person"

                android:scaleType="center"

                android:background="#E8E0FF"

                android:padding="25dp"

                android:clickable="true"
                android:focusable="true"

                android:contentDescription="Profile photo. Tap to add or change photo" />


            <!-- ================================================= -->
            <!-- PHOTO INSTRUCTION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Tap photo to add or change"

                android:textSize="13sp"

                android:textColor="#6B4DB5"

                android:textStyle="bold"

                android:layout_marginTop="10dp" />


            <!-- ================================================= -->
            <!-- NAME LABEL -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Name"

                android:textSize="13sp"

                android:textStyle="bold"

                android:textColor="#777777"

                android:layout_marginTop="28dp"

                android:layout_marginBottom="6dp" />


            <!-- ================================================= -->
            <!-- NAME -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/profileNameTextView"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Student"

                android:textSize="21sp"

                android:textStyle="bold"

                android:textColor="#292333"

                android:padding="16dp"

                android:background="#FFFFFF" />


            <!-- ================================================= -->
            <!-- EMAIL LABEL -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Email"

                android:textSize="13sp"

                android:textStyle="bold"

                android:textColor="#777777"

                android:layout_marginTop="18dp"

                android:layout_marginBottom="6dp" />


            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/profileEmailTextView"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Email"

                android:textSize="16sp"

                android:textColor="#555555"

                android:padding="16dp"

                android:background="#FFFFFF" />


            <!-- ================================================= -->
            <!-- LOGOUT -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/logoutButton"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:text="Logout"

                android:textAllCaps="false"

                android:textSize="16sp"

                android:textStyle="bold"

                android:textColor="@android:color/white"

                android:layout_marginTop="32dp"

                android:backgroundTint="#D32F2F" />

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- STUDENT BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/studentBottomNavigation"

        android:layout_width="match_parent"
        android:layout_height="75dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:background="@android:color/white"

        android:elevation="10dp"

        android:paddingTop="4dp"
        android:paddingBottom="4dp">


        <!-- STUDENT HOME -->

        <LinearLayout
            android:id="@+id/studentNavHome"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_home"

                android:contentDescription="Home"

                app:tint="#777777" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Home"

                android:textSize="11sp"

                android:textColor="#777777"

                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- STUDENT EVENTS -->

        <LinearLayout
            android:id="@+id/studentNavEvents"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_event"

                android:contentDescription="Events"

                app:tint="#777777" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Events"

                android:textSize="11sp"

                android:textColor="#777777"

                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- STUDENT MY EVENTS -->

        <LinearLayout
            android:id="@+id/studentNavMyEvents"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_confirmation"

                android:contentDescription="My Events"

                app:tint="#777777" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="My Events"

                android:textSize="11sp"

                android:textColor="#777777"

                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- STUDENT PROFILE -->

        <LinearLayout
            android:id="@+id/studentNavProfile"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_person"

                android:contentDescription="Profile"

                app:tint="#6B4DB5" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Profile"

                android:textSize="11sp"

                android:textColor="#6B4DB5"

                android:textStyle="bold"

                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- ADMIN BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/adminBottomNavigation"

        android:layout_width="match_parent"
        android:layout_height="75dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:background="@android:color/white"

        android:elevation="10dp"

        android:paddingTop="4dp"
        android:paddingBottom="4dp"

        android:visibility="gone">


        <!-- ADMIN HOME -->

        <LinearLayout
            android:id="@+id/adminNavHome"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_home"

                android:contentDescription="Home"

                app:tint="#777777" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Home"

                android:textSize="11sp"

                android:textColor="#777777"

                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- ADMIN EVENTS -->

        <LinearLayout
            android:id="@+id/adminNavEvents"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_event"

                android:contentDescription="Events"

                app:tint="#777777" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Events"

                android:textSize="11sp"

                android:textColor="#777777"

                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- ADMIN REGISTRATIONS -->

        <LinearLayout
            android:id="@+id/adminNavRegistrations"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_people"

                android:contentDescription="Registrations"

                app:tint="#777777" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Registrations"

                android:textSize="11sp"

                android:textColor="#777777"

                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- ADMIN PROFILE -->

        <LinearLayout
            android:id="@+id/adminNavProfile"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_person"

                android:contentDescription="Profile"

                app:tint="#6B4DB5" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Profile"

                android:textSize="11sp"

                android:textColor="#6B4DB5"

                android:textStyle="bold"

                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>